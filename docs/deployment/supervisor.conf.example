[program:hx-pay-queue]
process_name=%(program_name)s_%(process_num)02d
command=php /srv/hx-pay/artisan queue:work --queue=events,default --sleep=1 --tries=3 --timeout=60
numprocs=2
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
user=www-data
redirect_stderr=true
stdout_logfile=/var/log/hx-pay-worker.log
stopwaitsecs=90

[program:hx-pay-scheduler]
command=php /srv/hx-pay/artisan schedule:work
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
user=www-data
redirect_stderr=true
stdout_logfile=/var/log/hx-pay-scheduler.log
