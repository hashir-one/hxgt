APP_NAME="HX UPI Gateway"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=upi_gateway
DB_USERNAME=upi_gateway
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Configure SMTP from a transactional provider (SES, Resend or Brevo).
# Keep credentials in deployment secrets; never commit a populated .env.

# Optional bank-credit email capture. Keep disabled until real Kotak samples
# validate the parser and sender/authentication rules.
BANK_EMAIL_CONFIRMATION_ENABLED=false
BANK_EMAIL_MINIMUM_AMOUNT_MINOR=50000
BANK_EMAIL_SENDER_ALLOWLIST=
BANK_EMAIL_MERCHANT_ID=
BANK_EMAIL_USERNAME=
BANK_EMAIL_PASSWORD=
BANK_EMAIL_IMAP_HOST=imap.gmail.com
BANK_EMAIL_IMAP_PORT=993
BANK_EMAIL_IMAP_ENCRYPTION=ssl
BANK_EMAIL_IMAP_VALIDATE_CERT=true
EMAIL_INGEST_SECRET=
ADMIN_EMAIL=admin@example.com
DEMO_OWNER_EMAIL=owner@example.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

CHECKOUT_DOMAIN=http://127.0.0.1:8000
API_DOMAIN=http://127.0.0.1:8000
DEVICE_DOMAIN=http://127.0.0.1:8000
ORDER_EXPIRY_MINUTES=10
HEARTBEAT_INTERVAL_SECONDS=60
HEARTBEAT_TIMEOUT_SECONDS=90
HEALTHY_HEARTBEATS_TO_RESUME=2
SIGNAL_GRACE_SECONDS=120
CLAIM_MAX_ATTEMPTS=5
CLAIM_OPEN_HOURS=48
BREAKER_CONSECUTIVE_THRESHOLD=3
BREAKER_ROLLING_THRESHOLD=5
BREAKER_WINDOW_MINUTES=15
BREAKER_COOLDOWN_MINUTES=10

# Production console host; use four separate HTTPS hosts in production.
ADMIN_DOMAIN=http://127.0.0.1:8000
# Exact trusted client IP addresses, comma-separated; empty denies admin access in production.
ADMIN_IP_ALLOWLIST=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=
# Set both true under HTTPS in production.
SESSION_SECURE_COOKIE=false
# Set SESSION_ENCRYPT=true above for production sessions.

# Optional SSE occupies a PHP worker per open checkout. Load-test before enabling.
CHECKOUT_STREAM_ENABLED=false
# Alerts only; these settings never confirm or reject a payment.
ANOMALY_WINDOW_MINUTES=5
ANOMALY_PAYMENT_COUNT=30
ANOMALY_TINY_AMOUNT_MINOR=200
ANOMALY_TINY_COUNT=10
ANOMALY_TIMEZONE=Asia/Kolkata
ANOMALY_QUIET_HOURS=0,1,2,3,4,5

# Android attestation is disabled until an explicit environment identity and patch policy exist.
ANDROID_ATTESTATION_ENABLED=false
ANDROID_ATTESTATION_STAGING_IDENTITY_ENABLED=false
ANDROID_ATTESTATION_STAGING_PACKAGE=
ANDROID_ATTESTATION_STAGING_SIGNER_SHA256=
ANDROID_ATTESTATION_RELEASE_PACKAGE=
ANDROID_ATTESTATION_RELEASE_SIGNER_SHA256=
ANDROID_ATTESTATION_MIN_OS_VERSION=
ANDROID_ATTESTATION_MIN_OS_PATCH=
ANDROID_ATTESTATION_MIN_VENDOR_PATCH=
ANDROID_ATTESTATION_MIN_BOOT_PATCH=
ANDROID_ATTESTATION_MAX_PATCH_AGE_MONTHS=
# Optional single-key exception. Ignored outside APP_ENV=staging, including production.
ANDROID_ATTESTATION_STAGING_VENDOR_EXCEPTION_ENABLED=false
ANDROID_ATTESTATION_STAGING_VENDOR_EXCEPTION_SPKI_SHA256=
ANDROID_ATTESTATION_STAGING_VENDOR_EXCEPTION_MIN_PATCH=
ANDROID_ATTESTATION_STAGING_VENDOR_EXCEPTION_MAX_AGE_MONTHS=
